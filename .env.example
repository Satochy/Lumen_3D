NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SECRET_KEY=

DATABASE_URL=
DIRECT_URL=

# Frete (Melhor Envio) — token do servidor, nunca expor no cliente
MELHOR_ENVIO_TOKEN=
# URL opcional da API do Melhor Envio (ex: https://www.melhorenvio.com.br ou https://sandbox.melhorenvio.com.br)
MELHOR_ENVIO_API_URL=
# CEP de origem da loja (remessa), apenas dígitos ou com máscara
STORE_CEP=

# Pagamentos (Mercado Pago)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Segredo de validação da assinatura x-signature do webhook (obrigatório em produção)
MERCADOPAGO_WEBHOOK_SECRET=
# Ambiente do Mercado Pago (sandbox | production) e Collector ID opcional para validação estrita
MP_ENVIRONMENT=sandbox
MERCADOPAGO_COLLECTOR_ID=

# Estoque e Reserva Temporária de Pedidos (TTL em minutos — obrigatório em produção)
ORDER_RESERVATION_TTL_MINUTES=30
