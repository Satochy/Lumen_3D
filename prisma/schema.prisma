generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum LogisticsStatus {
  PREPARING
  PRODUCING
  PRINTING
  POST_PROCESSING
  READY_FOR_SHIPPING
  SHIPPED
  DELIVERED
  CANCELLED
}


enum ProductionStage {
  QUEUED
  PRINTING
  POST_PROCESSING
  COMPLETED
}

enum LeadStatus {
  NEW
  ANALYZING
  QUOTED
  APPROVED
  REJECTED
}

enum StockReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

enum StockMovementType {
  RESERVE
  CONSUME_RESERVE
  RELEASE_RESERVE
  RESTOCK_RETURN
  RETURN_RESTOCK
  MANUAL_ADJUST
}

enum PaymentAttemptStatus {
  INITIATED
  PENDING
  IN_PROCESS
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  REFUNDED
  UNKNOWN
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum PaymentRefundStatus {
  REQUESTED
  PROCESSING
  APPROVED
  FAILED
}

enum OrderOccurrenceType {
  DUPLICATE_PAYMENT
  DUPLICATE_APPROVED_PAYMENT
  LATE_PAYMENT_AFTER_CANCEL
  LATE_PAYMENT_AFTER_EXPIRY
  AMOUNT_OR_CURRENCY_MISMATCH
  COLLECTOR_OR_ENV_MISMATCH
  STOCK_CONFLICT_ON_CONFIRM
  RETURN_INSPECTION_REQUIRED
  RECONCILIATION_REQUIRED
}

enum OrderOccurrenceStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  username  String
  name      String
  avatarUrl String?
  birthDate DateTime?
  phone     String?
  cpf       String?   @unique
  role      Role      @default(CLIENT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orders         Order[]
  questions      Question[]
  addresses      Address[]
  paymentMethods PaymentMethod[]

  @@map("users")
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("addresses")
}

model PaymentMethod {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  providerToken String?
  lastFour      String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("payment_methods")
}

model Product {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  description    String
  price          Decimal   @db.Decimal(10, 2)
  stock          Int       @default(0)
  reservedStock  Int       @default(0)
  isMadeToOrder  Boolean   @default(false)
  productionDays Int?
  images         String[]
  category       String
  dimensions     String?
  weightGrams    Float?
  isFeatured     Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  variants          Variant[]
  orderItems        OrderItem[]
  questions         Question[]
  stockReservations StockReservation[]
  stockMovements    StockMovement[]

  @@map("products")
}

model Variant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String?
  stock         Int      @default(0)
  reservedStock Int      @default(0)
  priceOverride Decimal? @db.Decimal(10, 2)
  attributes    Json

  orderItems        OrderItem[]
  stockReservations StockReservation[]
  stockMovements    StockMovement[]

  @@map("variants")
}

model FilamentStock {
  id                String   @id @default(uuid())
  material          String
  color             String
  hexColor          String?
  spoolWeightKg     Float    @default(1.0)
  remainingGrams    Float
  minThresholdGrams Float    @default(200)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("filament_stocks")
}

model Order {
  id                      String          @id @default(uuid())
  userId                  String
  user                    User            @relation(fields: [userId], references: [id])
  paymentStatus           PaymentStatus   @default(PENDING)
  logisticsStatus         LogisticsStatus @default(PREPARING)
  totalAmount             Decimal         @db.Decimal(10, 2)
  shippingCost            Decimal         @default(0.00) @db.Decimal(10, 2)
  shippingAddressSnapshot Json?
  trackingCode            String?
  isLocalDelivery         Boolean         @default(false)
  isAssistedSale          Boolean         @default(false)
  adminNotes              String?
  externalPaymentId       String?
  paymentMethod           String?
  expiresAt               DateTime?
  paidAt                  DateTime?
  cancelledAt             DateTime?
  shippedAt               DateTime?
  deliveredAt             DateTime?
  hasOpenOccurrence       Boolean         @default(false)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  items             OrderItem[]
  stockReservations StockReservation[]
  paymentAttempts   PaymentAttempt[]
  paymentRefunds    PaymentRefund[]
  occurrences       OrderOccurrence[]

  @@map("orders")
}

model OrderItem {
  id                        String    @id @default(uuid())
  orderId                   String
  order                     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId                 String?
  product                   Product?  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productTitle              String
  quantity                  Int
  priceUnit                 Decimal   @db.Decimal(10, 2)
  isMadeToOrder             Boolean   @default(false)
  productionDays            Int?
  variantId                 String?
  variant                   Variant?  @relation(fields: [variantId], references: [id])
  variantAttributesSnapshot Json?
  isReady                   Boolean   @default(false)
  readyAt                   DateTime?
  readyByUserId             String?
  productionStage           ProductionStage @default(QUEUED)

  stockReservation StockReservation?

  @@map("order_items")
}

model StockReservation {
  id            String                 @id @default(uuid())
  orderId       String
  order         Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId   String                 @unique
  orderItem     OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId     String
  product       Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId     String?
  variant       Variant?               @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity      Int
  status        StockReservationStatus @default(ACTIVE)
  expiresAt     DateTime
  confirmedAt   DateTime?
  releasedAt    DateTime?
  releaseReason String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@map("stock_reservations")
}

model StockMovement {
  id             String            @id @default(uuid())
  idempotencyKey String            @unique
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        Variant?          @relation(fields: [variantId], references: [id], onDelete: SetNull)
  orderId        String?
  orderItemId    String?
  actorUserId    String?
  type           StockMovementType
  quantity       Int
  reason         String
  createdAt      DateTime          @default(now())

  @@map("stock_movements")
}

model PaymentAttempt {
  id                   String               @id @default(uuid())
  orderId              String
  order                Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider             String               @default("MERCADOPAGO")
  environment          String
  method               String
  idempotencyKey       String               @unique
  externalPaymentId    String?              @unique
  externalPreferenceId String?
  expectedAmount       Decimal              @db.Decimal(10, 2)
  paidAmount           Decimal?             @db.Decimal(10, 2)
  currency             String               @default("BRL")
  installments         Int                  @default(1)
  status               PaymentAttemptStatus @default(INITIATED)
  expiresAt            DateTime?
  failureReason        String?
  lastReconciledAt     DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([orderId, status])
  @@map("payment_attempts")
}

model PaymentRefund {
  id                String              @id @default(uuid())
  orderId           String
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attemptId         String?
  externalPaymentId String
  externalRefundId  String?             @unique
  idempotencyKey    String              @unique
  amount            Decimal             @db.Decimal(10, 2)
  isPartial         Boolean             @default(false)
  status            PaymentRefundStatus @default(REQUESTED)
  reason            String
  requestedByUserId String
  processedAt       DateTime?
  failureReason     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@map("payment_refunds")
}

model OrderOccurrence {
  id                String                @id @default(uuid())
  orderId           String
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attemptId         String?
  externalPaymentId String?
  type              OrderOccurrenceType
  status            OrderOccurrenceStatus @default(OPEN)
  description       String
  metadata          Json?
  resolvedByUserId  String?
  resolutionNotes   String?
  resolvedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@map("order_occurrences")
}

model LeadQuote {
  id             String     @id @default(uuid())
  clientName     String
  clientEmail    String
  clientPhone    String
  stlFileUrl     String
  notes          String?
  status         LeadStatus @default(NEW)
  estimatedPrice Decimal?   @db.Decimal(10, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("lead_quotes")
}

model Question {
  id        String   @id @default(uuid())
  content   String
  answer    String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("questions")
}

model PaymentWebhookLog {
  id               String                  @id @default(uuid())
  eventId          String                  @unique
  status           String
  provider         String                  @default("MERCADOPAGO")
  resourceId       String?
  orderId          String?
  attemptId        String?
  processingStatus WebhookProcessingStatus @default(RECEIVED)
  payloadSummary   Json?
  errorMessage     String?
  retryCount       Int                     @default(0)
  processedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @default(now()) @updatedAt

  @@map("payment_webhook_logs")
}
